<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.rp1</groupId><artifactId>rp1-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>loadgen</artifactId>
  <description>SFMC-style sender (2s timeout, retries, ledger), verifier (ledger vs Postgres/Kafka), DLQ replay. No Spring.</description>
  <dependencies>
    <dependency><groupId>com.rp1</groupId><artifactId>common</artifactId></dependency>
    <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- Repackage as a single executable jar (works for a plain main class; no Spring at runtime). -->
      <plugin>
        <groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
        <configuration><mainClass>com.rp1.loadgen.Main</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
