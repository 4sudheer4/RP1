<?xml version="1.0" encoding="UTF-8"?>
<!-- Stage-1 infra gate tool. Standalone (not part of the service multi-module build): plain kafka-clients,
     so the gate tests the broker setup, not Spring's producer configuration. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.rp1</groupId>
  <artifactId>stage1-gate</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <!-- Same client line Spring Boot 3.3 manages, so behavior matches what the services will use.
         slf4j-simple 1.7.x because kafka-clients 3.7 brings slf4j-api 1.7. -->
    <dependency><groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>3.7.1</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>1.7.36</version></dependency>
  </dependencies>
</project>
